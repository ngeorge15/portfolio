---
import Base from "../layouts/Base.astro";
import TypeScan from "../components/TypeScan.astro";
import { projects } from "../data/projects";
---
<Base
  title="Nikhil George"
  description="I enumerated a smart ring's undocumented Bluetooth service and found a body-temperature stream that no public documentation describes. Work in embedded reverse engineering, offline-first mobile, and quantitative systems."
>
  <section class="hero">
    <div class="page">
      <h1 class="measure">
        Thirty-two type bytes. One of them answers with a body-temperature
        stream that no public documentation describes.
      </h1>
      <p class="hero__sub measure">
        The Colmi R02 is a $20 smart ring with a second Bluetooth service its
        vendor never wrote down. Nobody had walked it, so I did, then built the
        health platform that reads what came back.
      </p>
    </div>

    <div class="page">
      <TypeScan />
    </div>
  </section>

  <section class="section" id="work">
    <div class="page">
      <h2>Work</h2>
      <ol class="work">
        {projects.map((p) => (
          <li class="entry">
            <div>
              <h3><a class="link" href={`/projects/${p.slug}`}>{p.title}</a></h3>
              <p class="entry__status" data-live={p.live ? "true" : "false"}>{p.status}</p>
            </div>
            <div class="entry__body">
              <p class="entry__summary">{p.summary}</p>
              <p class="muted">{p.detail}</p>
              <ul class="stack">{p.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vh, 4rem) 0; }
  .hero h1 { margin-bottom: 1.25rem; text-wrap: balance; }
  .hero__sub { font-size: 1.1rem; color: var(--ink-2); margin-bottom: 2.25rem; }

  .work { list-style: none; margin: 1.5rem 0 0; padding: 0; }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: .75rem 3rem;
    padding-block: 1.9rem;
    border-top: 1px solid var(--rule);
  }
  .entry:last-child { border-bottom: 1px solid var(--rule); }

  .entry h3 { margin-bottom: .35rem; }
  .entry h3 a { text-decoration: none; }
  .entry h3 a:hover { color: var(--trace); }

  /* Status is prose, not a chip and not monospace: it says how finished
     the thing is, which is a sentence-shaped fact. */
  .entry__status { margin: 0; font-size: var(--t-fine); color: var(--muted); }
  .entry__status[data-live="true"] { color: var(--trace); }

  .entry__summary { font-size: var(--t-body); }
  .entry__body p:not(.entry__summary) { font-size: var(--t-small); }

  .stack {
    display: flex; flex-wrap: wrap; gap: 0 .5rem;
    list-style: none; margin: 0; padding: 0;
    font-size: var(--t-fine); color: var(--faint);
  }
  .stack li:not(:last-child)::after { content: ","; }

  @media (max-width: 760px) {
    .entry { grid-template-columns: 1fr; gap: .6rem; }
  }
</style>
