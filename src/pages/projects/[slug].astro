---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";
import { caseStudies } from "../../data/case-studies";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const study = caseStudies[project.slug];
---

<Base
  title={`${project.title} — Nikhil George`}
  description={project.summary}
>
  <article>
    <header class="section head">
      <div class="page">
        <p class="crumb"><a class="link" href="/#work">Work</a></p>
        <h1 class="measure">{project.title}</h1>
        <p class="status" data-live={project.live ? "true" : "false"}>{project.status}</p>
        <p class="lede measure">{study ? study.lede : project.summary}</p>
        {!study && <p class="measure muted">{project.detail}</p>}
        <ul class="tech">{project.tags.map((t) => <li>{t}</li>)}</ul>

        {study?.links && (
          <p class="links">
            {study.links.map((l) => (
              <a class="link" href={l.href}>
                {l.label}{l.note && <span class="muted"> — {l.note}</span>}
              </a>
            ))}
          </p>
        )}
      </div>
    </header>

    {study?.constraint && (
      <section class="section bordered">
        <div class="page">
          <h2>{study.constraint.title}</h2>
          <p class="measure">{study.constraint.body}</p>
        </div>
      </section>
    )}

    {study?.metrics && (
      <section class="section bordered">
        <div class="page">
          <h2>{study.metrics.title}</h2>
          {study.metrics.note && <p class="measure muted note">{study.metrics.note}</p>}
          <dl class="metrics">
            {study.metrics.items.map((m) => (
              <div class="metric" data-measured={m.value ? "true" : "false"}>
                <dt>
                  <span class="metric__value">{m.value ?? "not yet measured"}</span>
                  <span class="metric__label">{m.label}</span>
                </dt>
                {m.method && <dd class="muted">{m.method}</dd>}
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {study?.decisions && (
      <section class="section bordered">
        <div class="page">
          <h2>Decisions</h2>
          <p class="measure muted note">
            The parts worth arguing about, and what each one cost.
          </p>
          <div class="decisions">
            {study.decisions.map((d) => (
              <article class="decision">
                <h3>{d.title}</h3>
                <div class="decision__body">
                  <p class="measure">{d.problem}</p>
                  <ul class="options measure">
                    {d.options.map((o) => <li>{o}</li>)}
                  </ul>
                  <p class="measure"><span class="tag tag--chose">Chose</span>{d.chose}</p>
                  <p class="measure muted"><span class="tag">Cost</span>{d.cost}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {study?.warStories && (
      <section class="section bordered">
        <div class="page">
          <h2>Things that were not in the docs</h2>
          <div class="stories">
            {study.warStories.map((w) => (
              <article class="story">
                <h3>{w.title}</h3>
                <p class="measure muted">{w.body}</p>
                {w.href && (
                  <p class="story__link">
                    <a class="link" href={w.href}>{w.hrefLabel ?? "Read the notes"}</a>
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {study?.limitations && (
      <section class="section bordered">
        <div class="page">
          <h2>{study.limitations.title}</h2>
          {study.limitations.note && (
            <p class="measure muted note">{study.limitations.note}</p>
          )}
          <ul class="limits measure">
            {study.limitations.items.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </section>
    )}

    {!study && (
      <section class="section bordered">
        <div class="page">
          <p class="measure muted">A fuller write-up of this one is still to come.</p>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .head { padding-block: 2.5rem 0; }
  .crumb { font-size: var(--t-fine); margin-bottom: 1.5rem; }
  .head h1 { margin-bottom: .75rem; }

  .status {
    margin: 0 0 1.5rem;
    font-size: var(--t-fine);
    color: var(--muted);
  }
  .status[data-live="true"] { color: var(--trace); }

  .lede { font-size: 1.1rem; }

  .tech {
    display: flex; flex-wrap: wrap; gap: 0 .5rem;
    list-style: none; margin: 0 0 1.25rem; padding: 0;
    font-size: var(--t-fine);
    color: var(--faint);
  }
  .tech li:not(:last-child)::after { content: ","; }

  .links { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: var(--t-small); margin: 0; }

  .bordered { border-top: 1px solid var(--rule); }
  .section { padding-block: clamp(2.5rem, 6vh, 4rem); }
  .note { font-size: var(--t-small); margin-top: .75rem; }
  h2 { margin-bottom: .5rem; }

  /* ── Metrics ─────────────────────────────────────────────────────
     Measured and unmeasured are visually distinct on purpose: the
     honesty of the distinction is the point, so it can't be skimmed
     past. Unmeasured entries stay legible, not hidden.               */

  .metrics { display: grid; gap: 0; margin: 1.75rem 0 0; }

  .metric { padding-block: 1.15rem; border-top: 1px solid var(--rule); }
  .metric:last-child { border-bottom: 1px solid var(--rule); }

  .metric dt { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .9rem; }

  .metric__value {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    color: var(--trace);
    min-width: 8.5rem;
  }
  /* An unmeasured figure is drawn but not filled in: the slot exists and
     is visibly empty, which is the honest rendering of "not measured yet". */
  .metric[data-measured="false"] .metric__value {
    color: var(--muted);
    font-size: var(--t-fine);
    font-family: var(--font-sans);
    border: 1px dashed var(--faint);
    padding: .05rem .45rem;
  }

  .metric__label { font-size: var(--t-small); }
  .metric[data-measured="false"] .metric__label { color: var(--muted); }

  .metric dd { margin: .4rem 0 0 0; font-size: var(--t-small); max-width: var(--measure); }

  /* ── Decisions ──────────────────────────────────────────────────── */

  .decisions { display: grid; gap: 0; margin-top: 1.75rem; }

  .decision {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 1rem 2.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
  }
  .decision:last-child { border-bottom: 1px solid var(--rule); }
  .decision h3 { font-size: 1.05rem; }
  .decision__body p:last-child { margin-bottom: 0; }
  .decision__body p { font-size: var(--t-small); }

  .options {
    margin: 0 0 1.1em;
    padding-left: 1.1rem;
    font-size: var(--t-small);
    color: var(--muted);
  }
  .options li { margin-bottom: .3rem; }

  .tag {
    display: inline-block;
    font-size: var(--t-fine);
    color: var(--faint);
    margin-right: .6rem;
  }
  .tag--chose { color: var(--trace); }

  /* ── Stories & limits ───────────────────────────────────────────── */

  .stories { display: grid; gap: 0; margin-top: 1.75rem; }
  .story { padding-block: 1.75rem; border-top: 1px solid var(--rule); }
  .story:last-child { border-bottom: 1px solid var(--rule); }
  .story h3 { font-size: 1.05rem; margin-bottom: .6rem; }
  .story p { font-size: var(--t-small); margin-bottom: 0; }
  .story__link { margin-top: .7rem; font-size: var(--t-fine); }

  .limits { margin-top: 1.5rem; padding-left: 1.1rem; font-size: var(--t-small); }
  .limits li { margin-bottom: .7rem; }

  @media (max-width: 720px) {
    .decision { grid-template-columns: 1fr; gap: .75rem; }
    .metric__value { min-width: 0; }
  }
</style>
